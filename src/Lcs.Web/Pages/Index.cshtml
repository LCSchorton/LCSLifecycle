@page
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>LCS Lifecycle Manager</title>
    <link rel="stylesheet" href="/site.css">
</head>
<body>
<header><div class="frame">Lanham Christian School</div></header>
<main class="frame">
    <h1>Student and device workspace</h1>
    <p class="intro">This test workspace is ready for staff sign-in. Student records and device inventory will appear after the school connects its systems.</p>
    <div class="modules">
        <section><h2>Student directory</h2><p>Review enrollment and match students to their school accounts.</p><p class="status">Awaiting roster connection</p></section>
        <section><h2>iPad inventory</h2><p>Find available iPads and review which students have them.</p><p class="status">Awaiting inventory connection</p></section>
        <section><h2>Student departures</h2><p>Track account closure and what happens to each student’s iPad.</p><p class="status">Workflow pending</p></section>
    </div>
</main>
</body>
</html>
